# --- Required for a persistent database (omit to use an in-memory MongoDB in dev) ---
MONGODB_URI=
# Set to true after creating the Atlas Vector Search index "rulecards_vector" (see README)
ATLAS_VECTOR_SEARCH=false

# --- Auth & encryption ---
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte key, hex (64 chars) or base64. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# --- LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Queue (optional; without it jobs run in-process) ---
REDIS_URL=

# --- Email reminders (optional; without SMTP they are logged to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FiscAI <reminders@example.com>

# --- App ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# --- Demo account (dev seed) ---
DEMO_EMAIL=demo@fiscai.local
DEMO_PASSWORD=fiscai-demo-2026
